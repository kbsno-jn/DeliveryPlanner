namespace Knowit.DeliveryPlanner;

using System.Threading;

page 70010 "DP Test Data KBS"
{
    Caption = 'DeliveryPlanner testdata';
    PageType = Card;
    ApplicationArea = All;
    UsageCategory = Administration;
    SourceTable = "DP Setup KBS";
    InsertAllowed = false;
    DeleteAllowed = false;
    ModifyAllowed = false;

    layout
    {
        area(Content)
        {
            group(Info)
            {
                Caption = 'Om denne siden';
                label(InfoText)
                {
                    ApplicationArea = All;
                    Caption = 'Oppretter et sett med hovedlager, transitt, butikker, varer og ordre som dekker eksemplene i DeliveryPlanner-planen. Kjør deretter Beregn DeliveryPlanner eller Kjør DeliveryPlanner fra DeliveryPlanner-oppsett og kontroller resultatet i kjøringslinjene.';
                }
            }
        }
    }
    actions
    {
        area(Processing)
        {
            action(CreateAllTestData)
            {
                Caption = 'Opprett alt testdata';
                ApplicationArea = All;
                Image = CreateForm;
                ToolTip = 'Oppretter hovedlager, butikker, varer og ordre for alle testscenarioene.';

                trigger OnAction()
                begin
                    TestData.CreateAll();
                end;
            }
            action(ToggleInvalidSetup)
            {
                Caption = 'Slå av/på ugyldig oppsett';
                ApplicationArea = All;
                Image = ErrorLog;
                ToolTip = 'Aktiverer eller deaktiverer en SKU med null makslager, for å teste at varen hoppes over og vises i avvikslisten.';

                trigger OnAction()
                begin
                    TestData.ToggleInvalidSetup();
                end;
            }
            action(CreateDemoData)
            {
                Caption = 'Opprett demodatasett (stort)';
                ApplicationArea = All;
                Image = CreateDocuments;
                ToolTip = 'Oppretter hovedlager, 15 butikker, 80 varer, 56 dager bokført salg og 8 uker kjøringshistorikk i bakgrunnen. Krever et selskap med standard bokføringsoppsett, for eksempel CRONUS. Tar typisk 30–60 minutter.';

                trigger OnAction()
                begin
                    DemoData.Schedule();
                end;
            }
            action(PrepareToday)
            {
                Caption = 'Klargjør demo for i dag';
                ApplicationArea = All;
                Image = Calendar;
                ToolTip = 'Setter leveringsdagen for Bodø slik at en stor ordre venter på godkjenning når DeliveryPlanner kjøres i dag.';

                trigger OnAction()
                begin
                    DemoData.PrepareToday(true);
                end;
            }
            action(JobQueue)
            {
                Caption = 'Jobbkøposter';
                ApplicationArea = All;
                Image = JobListSetup;
                ToolTip = 'Viser status for jobben som oppretter demodataene.';
                RunObject = page "Job Queue Entries";
            }
            action(OpenSetup)
            {
                Caption = 'Åpne DeliveryPlanner-oppsett';
                ApplicationArea = All;
                Image = Setup;
                ToolTip = 'Åpner DeliveryPlanner-oppsett for å beregne eller kjøre planleggingen.';
                RunObject = page "DP Setup KBS";
            }
        }
        area(Promoted)
        {
            actionref(CreateAllTestDataPromoted; CreateAllTestData) { }
            actionref(CreateDemoDataPromoted; CreateDemoData) { }
            actionref(PrepareTodayPromoted; PrepareToday) { }
            actionref(OpenSetupPromoted; OpenSetup) { }
        }
    }

    var
        TestData: Codeunit "DP Test Data KBS";
        DemoData: Codeunit "DP Demo Data KBS";
}
