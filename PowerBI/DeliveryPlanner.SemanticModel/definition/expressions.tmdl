expression Kilde_DP =
		(Entitet as text) as table =>
		    OData.Feed(
		        "https://api.businesscentral.dynamics.com/v2.0/" & Tenant & "/" & Miljo
		            & "/api/knowit/deliveryPlanner/v1.0/companies(" & FirmaId & ")/" & Entitet,
		        null,
		        [Implementation = "2.0"])
	lineageTag: cde5ffdd-d31e-4ba4-b3d4-d07fec37bbb5

	annotation PBI_ResultType = Function

expression Kilde_BC =
		(Entitet as text) as table =>
		    OData.Feed(
		        "https://api.businesscentral.dynamics.com/v2.0/" & Tenant & "/" & Miljo
		            & "/api/v2.0/companies(" & FirmaId & ")/" & Entitet,
		        null,
		        [Implementation = "2.0"])
	lineageTag: 80e81097-e36f-4347-b1f4-a215aaa25326

	annotation PBI_ResultType = Function

expression GyldigeKjoringer =
		let
		    Kjøringer = Kilde_DP("deliveryRuns"),
		    Fullført = Table.SelectRows(Kjøringer, each [status] = "Completed" and [createOrders] = true),
		    SistePerDato = Table.Group(Fullført, {"planningDate"}, {{"Siste", each Table.Max(_, "startedAt"), type record}}),
		    Utvidet = Table.ExpandRecordColumn(SistePerDato, "Siste", {"runId", "salesHistoryDays"}),
		    Valgt = Table.SelectColumns(Utvidet, {"runId", "salesHistoryDays"})
		in
		    Valgt
	lineageTag: 6a84517f-af78-4a15-8e3a-efdfbab2368f

	annotation PBI_ResultType = Table

