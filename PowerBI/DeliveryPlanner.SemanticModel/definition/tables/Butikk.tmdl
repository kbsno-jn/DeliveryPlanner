	column Butikkode
		dataType: string
		lineageTag: 6804443a-1cec-4e68-a0c1-4a7b72783458
		summarizeBy: none
		sourceColumn: code

		annotation SummarizationSetBy = User

	column Butikk
		dataType: string
		lineageTag: 0474b78a-d2d0-4f45-98d5-f417e5a4bc69
		summarizeBy: none
		sourceColumn: name

		annotation SummarizationSetBy = User

	column Aktivert
		dataType: boolean
		lineageTag: a735a977-dcd3-4704-85fa-022fe72e4598
		summarizeBy: none
		sourceColumn: deliveryPlannerEnabled

		annotation SummarizationSetBy = User

	column Kategorikode
		dataType: string
		lineageTag: 4526654c-7a1a-49ac-af4d-e29cd21b1883
		summarizeBy: none
		sourceColumn: categoryCode

		annotation SummarizationSetBy = User

	column Leveringsdager
		dataType: string
		lineageTag: 6a5d612f-817b-49b0-9b65-c8e1c621773e
		summarizeBy: none
		sourceColumn: Leveringsdager

		annotation SummarizationSetBy = User

	partition Butikk = m
		mode: import
		source =
				let
				    Butikker = Kilde_DP("deliveryStores"),
				    MedDager = Table.AddColumn(Butikker, "Leveringsdager", each
				        let
				            Dager = List.Select({
				                if [deliveryMonday] then "Man" else null,
				                if [deliveryTuesday] then "Tir" else null,
				                if [deliveryWednesday] then "Ons" else null,
				                if [deliveryThursday] then "Tor" else null,
				                if [deliveryFriday] then "Fre" else null,
				                if [deliverySaturday] then "Lør" else null,
				                if [deliverySunday] then "Søn" else null}, each _ <> null)
				        in
				            if List.IsEmpty(Dager) then "Hver natt" else Text.Combine(Dager, ", "), type text),
				    Valgt = Table.SelectColumns(MedDager, {"code", "name", "deliveryPlannerEnabled", "categoryCode", "Leveringsdager"}),
				    Typer = Table.TransformColumnTypes(Valgt, {{"code", type text}, {"name", type text}, {"deliveryPlannerEnabled", type logical}, {"categoryCode", type text}, {"Leveringsdager", type text}})
				in
				    Typer

	annotation PBI_ResultType = Table

