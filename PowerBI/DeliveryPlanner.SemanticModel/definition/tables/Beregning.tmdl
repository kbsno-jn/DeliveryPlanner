	partition Beregning = m
		mode: import
		source =
				let
				    Linjer = Kilde_DP("deliveryRunLines"),
				    // Filter on the planning date first, so incremental refresh can send the filter to the API.
				    Periode = Table.SelectRows(Linjer, each [planningDate] >= Date.From(RangeStart) and [planningDate] < Date.From(RangeEnd)),
				    Gyldige = Table.NestedJoin(Periode, {"runId"}, GyldigeKjoringer, {"runId"}, "Kjøring", JoinKind.Inner),
				    MedPeriode = Table.ExpandTableColumn(Gyldige, "Kjøring", {"salesHistoryDays"}),
				    Valgt = Table.SelectColumns(MedPeriode, {"planningDate", "itemNumber", "variantCode", "locationCode", "categoryCode", "soldQuantity", "daysInStock", "soldLastDay", "dailySales", "daysOfCover", "shipsNow", "receiptDate", "nextReceiptDate", "coverageDays", "targetQuantity", "maximumInventory", "inventory", "incomingQuantity", "outgoingQuantity", "capacityQuantity", "needQuantity", "suggestedQuantity", "allocatedQuantity", "unmetQuantity", "exception", "reason", "salesHistoryDays"}),
				    Typer = Table.TransformColumnTypes(Valgt, {{"planningDate", type date}, {"itemNumber", type text}, {"variantCode", type text}, {"locationCode", type text}, {"categoryCode", type text}, {"soldQuantity", type number}, {"daysInStock", Int64.Type}, {"soldLastDay", type logical}, {"dailySales", type number}, {"daysOfCover", type number}, {"shipsNow", type logical}, {"receiptDate", type date}, {"nextReceiptDate", type date}, {"coverageDays", Int64.Type}, {"targetQuantity", type number}, {"maximumInventory", type number}, {"inventory", type number}, {"incomingQuantity", type number}, {"outgoingQuantity", type number}, {"capacityQuantity", type number}, {"needQuantity", type number}, {"suggestedQuantity", type number}, {"allocatedQuantity", type number}, {"unmetQuantity", type number}, {"exception", type text}, {"reason", type text}, {"salesHistoryDays", Int64.Type}})
				in
				    Typer

	annotation PBI_ResultType = Table

